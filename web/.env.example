# Template only. Placeholders, never real values.
#
# Copy to .env.local and fill that in instead:
#   cp .env.example .env.local
#
# .env.local is gitignored. THIS file is committed and public, so a real
# credential pasted here goes straight to GitHub.

# Canonical origin, no trailing slash. Drives canonical tags, OG urls, robots
# and the sitemap. Leave blank locally; Vercel falls back to the project's
# production hostname on its own. Set this once a custom domain exists.
NEXT_PUBLIC_SITE_URL=

# Neon pooled connection (hostname contains "-pooler"). Used by API routes.
DATABASE_URL=

# Neon direct connection (no "-pooler"). Used by the ingestion job and
# migrations, which need a real session for bulk COPY and transactions.
DATABASE_URL_DIRECT=

# Optional. Free token from any Socrata portal's Developer Settings.
SOCRATA_APP_TOKEN=
